[Unit]
Description=GSB Gateway UDP relay (udpgw over TLS)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/gsb-relay -listen :443 -dir /var/lib/gsb-relay
Restart=on-failure
DynamicUser=yes
StateDirectory=gsb-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
